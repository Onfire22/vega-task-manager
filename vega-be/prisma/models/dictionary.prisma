enum Type {
  TASK_PRIORITY
  ROLE_TYPE
  USER_SPECIALISATION
  TASK_STATUS
  TASK_TYPE
  PROJECT_STATUS
  CHAT_ROLE
}

model Dictionary {
  uuid String @id @default(uuid())

  label       String
  key         String
  type        Type
  description String?

  users           User[]
  memberships     Membership[]
  taskPriorities  Task[]            @relation("TaskPriority")
  taskStatuses    Task[]            @relation("TaskStatus")
  taskStacks      Task[]            @relation("TaskStack")
  projectStatus   Project[]
  chatMemberships ChatMemberships[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, type])
  @@map("dictionaries")
}
