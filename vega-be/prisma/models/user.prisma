model User {
  uuid String @id @default(uuid())

  name        String
  secondName  String  @map("second_name")
  email       String  @unique
  password    String
  userName    String  @unique @map("user_name")
  avatarUrl   String? @map("avatar_url")
  isSuperUser Boolean @default(false) @map("is_super_user")

  assignedTasks       Task[]               @relation("AssignedTasks")
  reportedTasks       Task[]               @relation("ReportedTasks")
  memberships         Membership[]
  comments            Comment[]
  timeLogs            TimeLog[]
  notificationsFrom   Notification[]       @relation("FromUser")
  notificationsTo     Notification[]       @relation("ToUser")
  chatMemberships     ChatMemberships[]
  chatMessages        ChatMessages[]
  projectsMemberships ProjectsMembership[]
  teamMembers         TeamMembers[]

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  dictionary     Dictionary? @relation(fields: [dictionaryUuid], references: [uuid])
  dictionaryUuid String?

  @@map("users")
}
