enum EntityType {
  TASK
  TASK_STATUS
  PROJECT
}

model Notification {
  id String @id @default(uuid())

  isReaded   Boolean    @default(false) @map("is_readed")
  extraData  String?    @map("extra_data")
  entityType EntityType

  fromUserUuid    String      @map("from_user_uuid")
  fromUser        User        @relation("FromUser", fields: [fromUserUuid], references: [id])
  toUserUuid      String      @map("to_user_uuid")
  toUser          User        @relation("ToUser", fields: [toUserUuid], references: [id])
  taskUuid        String?     @map("task_uuid")
  task            Task?       @relation(fields: [taskUuid], references: [id])
  memberShipsUuid String?     @map("memberships_uuid")
  memberships     Membership? @relation(fields: [memberShipsUuid], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}
