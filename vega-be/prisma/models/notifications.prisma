enum EntityType {
  TASK
  PROJECT
}

model Notification {
  id String @id @default(uuid())

  isReaded   Boolean    @default(false) @map("is_readed")
  entityType EntityType

  userUuid        String      @map("user_uuid")
  user            User        @relation(fields: [userUuid], references: [id])
  taskUuid        String?     @map("task_uuid")
  task            Task?       @relation(fields: [taskUuid], references: [id])
  memberShipsUuid String?     @map("memberships_uuid")
  memberships     Membership? @relation(fields: [memberShipsUuid], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}
