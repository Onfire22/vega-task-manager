enum Type {
  TASK_PRIORITY
  ROLE_TYPE
  STACK_TYPE
  TASK_STATUS
}

model Dictionaries {
  id String @id @default(uuid())

  name     String
  fullName String? @map("full_name")
  color    String?
  type     Type

  users          User[]
  memberships    Membership[]
  taskPriorities Task[]       @relation("TaskPriority")
  taskStatuses   Task[]       @relation("TaskStatus")
  taskStacks     Task[]       @relation("TaskStack")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dictionaries")
}
