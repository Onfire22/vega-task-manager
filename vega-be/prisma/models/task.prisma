model Task {
  id String @id @default(uuid())

  code             String?    @unique
  title            String
  description      String
  estimateTime     Int?       @map("estimate_time")
  remainingTime    Int?       @map("remaining_time")
  assigneeUuid     String?    @map("assignee_uuid")
  assignee         User?      @relation("AssignedTasks", fields: [assigneeUuid], references: [id])
  reporterUuid     String     @map("reporter_uuid")
  reporter         User       @relation("ReportedTasks", fields: [reporterUuid], references: [id])
  projectUuid      String?    @map("project_uuid")
  project          Project?   @relation(fields: [projectUuid], references: [id])
  taskPriorityUuid String     @map("task_priority_uuid")
  taskPriority     Dictionary @relation("TaskPriority", fields: [taskPriorityUuid], references: [id])
  taskStatusUuid   String     @map("task_status_uuid")
  taskStatus       Dictionary @relation("TaskStatus", fields: [taskStatusUuid], references: [id])
  taskStackUuid    String     @map("task_stack_uuid")
  taskStack        Dictionary @relation("TaskStack", fields: [taskStackUuid], references: [id])

  timeLogs TimeLog[]
  comments Comment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}
