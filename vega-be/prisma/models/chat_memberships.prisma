model ChatMemberships {
  uuid String @id @default(uuid())

  userRoleUuid String       @map("user_role_uuid")
  userRole     Dictionary   @relation(fields: [userRoleUuid], references: [uuid])
  userUuid     String
  user         User         @relation(fields: [userUuid], references: [uuid])
  channelUuid  String       @map("channel_uuid")
  channel      ChatChannels @relation(fields: [channelUuid], references: [uuid])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userUuid, channelUuid], name: "user_channel")
  @@map("chat_memberships")
}
