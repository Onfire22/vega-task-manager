model Comment {
  id String @id @default(uuid())

  text String

  taskUuid   String @map("task_uuid")
  task       Task   @relation(fields: [taskUuid], references: [id])
  authorUuid String @map("author_uuid")
  author     User   @relation(fields: [authorUuid], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("comments")
}
