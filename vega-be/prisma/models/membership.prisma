model Membership {
  uuid String @id @default(uuid())

  userUuid    String
  user        User    @relation(fields: [userUuid], references: [uuid])
  projectUuid String  @map("prject_uuid")
  project     Project @relation(fields: [projectUuid], references: [uuid])

  userRoleUuid String     @map("user_role_uuid")
  userRole     Dictionary @relation(fields: [userRoleUuid], references: [uuid])

  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userUuid, projectUuid], name: "user_project")
  @@map("memberships")
}
