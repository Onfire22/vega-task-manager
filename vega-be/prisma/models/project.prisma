model Project {
  id String @id @default(uuid())

  title             String
  description       String
  code              String
  projectStatusUuid String     @map("project_status_uuid")
  projectStatus     Dictionary @relation(fields: [projectStatusUuid], references: [id])

  tasks       Task[]
  memberships Membership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}
